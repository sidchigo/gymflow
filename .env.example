# =============================================================================
# GymFlow — Environment Variables Template
# Copy this to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ── Next.js ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Session Cookie ────────────────────────────────────────────────────────────
# 32-byte (256-bit) secret for iron-session encryption.
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET
SESSION_COOKIE_NAME=gymflow_session

# ── Gym API (server-side only — never expose to the browser) ─────────────────
GYM_API_BASE_URL=https://api.yourgym.example.com

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_TOKEN

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Set to "gemini" to use Google GenAI SDK, or "openai" for any OpenAI-compatible API (e.g. OpenRouter, OpenCode).
LLM_PROVIDER=openai
# Active model name. E.g. "gemini-2.5-flash", "google/gemini-2.5-flash", or "deepseek/deepseek-chat".
LLM_MODEL=google/gemini-2.5-flash
# The secret API key.
LLM_API_KEY=REPLACE_WITH_YOUR_LLM_PROVIDER_API_KEY
# Custom base URL (leave blank for Gemini default, or set to your OpenAI-compatible endpoint like "https://openrouter.ai/api/v1").
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Development Flags ─────────────────────────────────────────────────────────
# Set to "true" to use the mock gym client backed by fixtures/ instead of the
# live gym API. Safe to leave on in development when you have no credentials.
GYM_USE_MOCK=true

# ── Session JWT ───────────────────────────────────────────────────────────────
# 32-byte (256-bit) secret used by jose to sign the internal HttpOnly JWT cookie.
# Generate with: openssl rand -hex 32
SESSION_JWT_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET
