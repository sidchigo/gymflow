{
  "$schema": "./eval-schema.json",
  "version": "1.0.0",
  "description": "Deterministic evaluation scenarios for GymFlow S&C & Combat Sports Agent Engine",
  "scenarios": [
    {
      "id": "SCENARIO_01_INITIAL_5DAY_PLAN_GENERATION",
      "description": "Athlete requests initial 5-day week plan. Agent must schedule 1 KB and 1 BJJ class based on timetable, align heavy lifting with WFH days, program supersets on WFO days, and reserve Sunday for full rest.",
      "input": {
        "userMessage": "Generate my training and nutrition plan for the week.",
        "currentDateTimeIST": "2026-08-24T06:30:00+05:30",
        "athleteState": {
          "userId": "user_01",
          "profile": {
            "userId": "user_01",
            "weightKg": 69,
            "heightCm": 169,
            "targetDaysPerWeek": 5,
            "weightUnitPreference": "KG",
            "mandatoryCombatSessions": { "kickboxing": 1, "bjj": 1 },
            "weeklyWorkSchedule": {
              "Monday": { "mode": "WFH", "commuteMinutesOneWay": 30 },
              "Tuesday": { "mode": "WFO", "commuteMinutesOneWay": 65 },
              "Wednesday": { "mode": "WFH", "commuteMinutesOneWay": 30 },
              "Thursday": { "mode": "WFO", "commuteMinutesOneWay": 65 },
              "Friday": { "mode": "WFH", "commuteMinutesOneWay": 30 },
              "Saturday": { "mode": "WFH", "commuteMinutesOneWay": 30 },
              "Sunday": { "mode": "WFH", "commuteMinutesOneWay": 30 }
            },
            "dietaryPreference": "HIGH_PROTEIN_NON_VEG",
            "targetDailyProteinGrams": 125
          },
          "lifts": [],
          "events": []
        },
        "weeklySchedule": {
          "lastFetchedAt": "2026-08-24T06:00:00.000+05:30",
          "slots": [
            { "id": "slot_kb_mon", "date": "2026-08-24", "startTime": "19:00", "endTime": "20:00", "title": "Kickboxing / S&C", "trainer": "Vikram", "room": "Combat Area", "tier": "NORMAL" },
            { "id": "slot_bjj_wed", "date": "2026-08-26", "startTime": "19:30", "endTime": "20:30", "title": "BJJ Ground Game", "trainer": "Marcus", "room": "Dojo", "tier": "NORMAL" },
            { "id": "slot_trx_thu", "date": "2026-08-27", "startTime": "07:30", "endTime": "08:15", "title": "TRX Conditioning", "trainer": "Rahul", "room": "Studio A", "tier": "NORMAL" }
          ],
          "diffs": []
        }
      },
      "expectedAssertions": {
        "toolCall": "replan_week_schedule",
        "planRules": [
          { "condition": "plan.length === 7", "message": "Plan must span exactly 7 days from Monday to Sunday" },
          { "condition": "plan.filter(d => d.modality !== 'REST').length === 5", "message": "Exactly 5 training days programmed" },
          { "condition": "plan.find(d => d.date === '2026-08-24').gymSlotId === 'slot_kb_mon'", "message": "Monday binds to Kickboxing slot" },
          { "condition": "plan.find(d => d.date === '2026-08-26').gymSlotId === 'slot_bjj_wed'", "message": "Wednesday binds to BJJ slot" },
          { "condition": "plan.find(d => d.date === '2026-08-30').modality === 'REST'", "message": "Sunday must be complete REST" },
          { "condition": "plan.find(d => d.date === '2026-08-25').exercises.some(e => e.supersetGroupId !== null)", "message": "Tuesday (WFO) uses superset grouping for time efficiency" }
        ]
      }
    },
