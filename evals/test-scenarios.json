            { "id": "slot_trx_thu", "date": "2026-08-27", "startTime": "07:30", "endTime": "08:15", "title": "TRX Conditioning", "trainer": "Rahul", "room": "Studio A", "tier": "NORMAL" }
          ],
          "diffs": [
            {
              "type": "CANCELLED",
              "slotId": "slot_bjj_wed",
              "title": "BJJ Ground Game",
              "date": "2026-08-26",
              "originalTime": "19:30",
              "updatedTime": null,
              "detectedAt": "2026-08-25T14:30:00.000+05:30"
            }
          ]
        }
      },
      "expectedAssertions": {
        "toolCall": "replan_week_schedule",
        "planRules": [
          { "condition": "plan.find(d => d.date === '2026-08-26').isGymClass === false", "message": "Wednesday must not be bound to cancelled gym slot" },
          { "condition": "['KB_CONDITIONING', 'BOXING_CONDITIONING', 'UPPER_HYPERTROPHY', 'LOWER_STRENGTH', 'DUT', 'TRX', 'AB_ASSAULT', 'MOBILITY_RECOVERY', 'REST'].includes(plan.find(d => d.date === '2026-08-26').modality)", "message": "Wednesday replaced with valid alternative open-floor modality" }
        ]
      }
    },
